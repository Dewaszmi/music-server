services:
  navidrome:
    image: deluan/navidrome:latest
    user: 1000:1000 # should be owner of volumes
    ports:
      - "4533:4533"
    restart: unless-stopped
    environment:
      ND_LASTFM_SCROBBLEFIRSTARTISTONLY: "true"
    volumes:
      - "DATA_VOLUME:/data"
      - "MUSIC_VOLUME:/music"
